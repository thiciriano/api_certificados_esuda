# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA vai para o Git (esta no .gitignore) — aqui so ficam os valores de exemplo.

PROJECT_NAME=Esuda Certificados
API_V1_STR=/api/v1
VERSION=2.0.0

# --- JWT ---
# Gere uma chave aleatoria com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria
JWT_ALGORITHM=HS256
# Tempo de expiracao do token em minutos (1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Banco de dados ---
# SQLite local por padrao; em producao o Render injeta o Postgres aqui.
DATABASE_URL=sqlite:///./esuda_certificados.db
# true mostra o SQL no console (util para depurar)
DB_ECHO=false
